{
  "name": "decky-bluetooth-order",
  "version": "0.1.0",
  "description": "Configurable sorting of the native Steam Deck Bluetooth menus",
  "type": "module",
  "license": "MIT",
  "author": "JediRhymeTrix",
  "homepage": "https://github.com/JediRhymeTrix/decky-bluetooth-order#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JediRhymeTrix/decky-bluetooth-order.git"
  },
  "bugs": {
    "url": "https://github.com/JediRhymeTrix/decky-bluetooth-order/issues"
  },
  "keywords": ["decky", "steam-deck", "bluetooth", "sorting"],
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "rollup -c",
    "typecheck": "tsc --noEmit",
    "test:frontend": "node --experimental-strip-types --loader ./tests/ts-loader.mjs --test tests/frontend/*.test.ts",
    "test:backend": "python3 -m unittest discover -s tests -p 'backend*.py'",
    "test:packaging": "python3 -m unittest discover -s tests -p 'packaging*.py'",
    "test:automation": "python3 -m unittest discover -s tests -p 'automation*.py'",
    "test": "pnpm test:frontend && pnpm test:backend && pnpm test:packaging && pnpm test:automation",
    "vendor": "python3 scripts/vendor_deps.py",
    "package": "python3 scripts/package.py",
    "package-check": "python3 scripts/package.py --check",
    "validate": "pnpm typecheck && pnpm test && pnpm build && pnpm vendor && pnpm package-check",
    "release:build": "pnpm validate && pnpm package"
  },
  "dependencies": {
    "@decky/api": "1.1.3",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@decky/rollup": "1.0.2",
    "@decky/ui": "4.12.1",
    "@types/node": "22.10.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/react-test-renderer": "18.3.0",
    "@types/webpack": "5.28.5",
    "react": "18.3.1",
    "react-test-renderer": "18.3.1",
    "rollup": "4.53.3",
    "typescript": "5.6.2"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}